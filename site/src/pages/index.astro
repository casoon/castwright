---
import { readFile } from 'node:fs/promises';
import config from 'virtual:casoon-pages/config';
import {
  Badge,
  Badges,
  Button,
  CodeBlock,
  Facts,
  Faq,
  Features,
  Hero,
  Install,
  Quickstart,
  ReleaseHighlights,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { url } from '@casoon/pages-theme/url';
import Diagram from '../components/Diagram.astro';

// The hero is castwright's own output: src/demos/hero-svg.terminal.yaml, built
// to an animated SVG by `castwright build --format svg` before every site build
// (scripts/build-svgs.mjs). No player and no script — the same file a README gets.
// width/height are the SVG's viewBox.

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased',
    )
  : undefined;
---

<Base>
  <Hero
    title="Terminal demos you write, not record."
    lead="Describe a terminal session in a short YAML file. castwright turns it into the demo for your README, docs or landing page — an animated SVG, a live terminal or a GIF. No screen recording, no retakes."
  >
    <Install
      commands={[
        { label: 'pnpm', command: 'pnpm add -D @casoon/castwright' },
        { label: 'npm', command: 'npm i -D @casoon/castwright' },
        { label: 'yarn', command: 'yarn add -D @casoon/castwright' },
      ]}
    />
    <Badges>
      <Badge>Free · MIT</Badge>
      <Badge>v{config.version}</Badge>
      <Badge>Node 22+</Badge>
      <Badge>asciicast v2</Badge>
    </Badges>
    <img
      slot="output"
      class="hero-scene"
      src={url('/svg/hero-svg.svg')}
      width="477.6"
      height="350"
      alt="Terminal: cat deploy.terminal.yaml shows a short castwright scene, highlighted, in which npm run deploy prints two green check marks for build and upload. castwright build deploy.terminal.yaml --format svg then writes dist/deploy.svg, and castwright build without a format writes dist/deploy.cast."
    />
  </Hero>

  <Features
    heading="Who it is for"
    items={[
      {
        title: 'Anyone with a CLI to show',
        body: 'Your README needs to show the tool working. Instead of a screen recording that goes stale with the next release, you keep a file next to the code and rebuild the demo from it.',
      },
      {
        title: 'Docs and landing pages',
        body: 'A real terminal in the page, not a video: selectable text, a pause control, and with reduced motion the final frame straight away.',
      },
      {
        title: 'Real output, recorded once',
        body: 'Let castwright run a command once and keep exactly what it printed. Every later build replays those bytes, on any machine. An existing VHS .tape builds as it is.',
      },
    ]}
  />

  <Facts
    items={[
      { value: '4', label: 'output formats: cast, SVG, GIF and MP4' },
      { value: '7', label: 'bundled terminal themes' },
      { value: '0', label: 'scripts in the SVG — it plays on GitHub' },
      { value: '0', label: 'headless browsers in your build' },
    ]}
  />

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">How it works</h2>
    <div class="text">
      <p>
        A scene is a list of steps: a command that gets typed, what it prints, a file to show,
        a pause. You write it like any other file in your repository and review it in a diff.
      </p>
      <p>
        castwright compiles the scene to a standard asciicast file, byte for byte the same on
        every build. From there it becomes whatever the place needs: a player for the web page,
        an animated SVG for the README, or a GIF and MP4 for everywhere else.
      </p>
    </div>
    <Diagram name="how-it-works" format="svg" narrow={{ width: 380, height: 520 }} />
    <div class="links">
      <Button href={url('docs/guides/writing-demos/')} variant="secondary">Writing demos</Button>
      <Button href={url('docs/guides/recipes/')} variant="secondary">Recipes</Button>
      <Button href={url('demo/')} variant="quiet">See it play live →</Button>
    </div>
  </section>

  <Quickstart
    lead="From an empty file to a demo in your README. Putting the player on a page, the full walkthrough and every option are in the documentation."
    steps={[
      'Write a <code>demo.terminal.yaml</code>: the commands to type and what they print.',
      'Build it to an animated SVG with one command.',
      'Put it in your README as an <code>&lt;img&gt;</code>, or play it in the page with the Vite plugin or the Astro component.',
    ]}
  >
    <CodeBlock code="npx castwright build demo.terminal.yaml --format svg" lang="sh" label="Build" />
  </Quickstart>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'What does a build actually produce?',
        a: 'One asciicast v2 file. From there it becomes a web player, an animated SVG for a README, or a GIF or MP4 through agg and ffmpeg — whichever the place needs.',
      },
      {
        q: 'Does it need a headless browser or a screen recording?',
        a: 'No. The compiler runs in plain Node, and the same input always produces the same bytes — no wall clock, no unseeded randomness — so a compiled cast is a text file you can commit and read in a diff.',
      },
      {
        q: 'Can a scene show real command output instead of typed-out text?',
        a: 'Yes. An exec: step runs the command for real in a pseudo-terminal, and --record writes what it printed back into the file, so every later build replays those exact bytes instead of running anything again.',
      },
      {
        q: 'Does it only work with Astro?',
        a: 'No. @casoon/astro-castwright is a thin wrapper around a Vite plugin that also covers SvelteKit, Nuxt, Remix, SolidStart, Qwik, VitePress and plain Vite — and with no bundler at all, a single script tag loads the player.',
      },
      {
        q: 'Is the player accessible?',
        a: "Yes. Its children are the terminal's real, selectable final text, generated at build time; reduced motion shows that final frame immediately, there is always a real pause control, and it is never a keyboard trap.",
      },
    ]}
  />
</Base>

<style>
  /* Never scale the scene beyond a readable terminal size. */
  .hero-scene {
    display: block;
    width: 100%;
    max-width: 640px;
    height: auto;
    margin: 0 auto;
  }
  .how {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .text {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 48px;
  }
  .text p {
    margin: 0 0 16px;
    font-size: 15.5px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
</style>
