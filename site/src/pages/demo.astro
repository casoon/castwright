---
import { Callout, CodeBlock, Demo } from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { url } from '@casoon/pages-theme/url';
import Cast from '../components/Cast.astro';

// Every player below is compiled during this build by castwright's own Vite
// plugin (src/demos.ts); the file each one came from is one click away.
const themes = ['default', 'dracula', 'solarized-dark', 'github-light'];
---

<Base
  title="Live demo"
  description="castwright running in the page: realistic scenarios and every feature, compiled during this build and played by the real player."
>
  <div class="page">
    <h1>Live demo</h1>
    <p class="lead">
    Everything below is the player itself, running here. Each demo was compiled during this
    build from the file under “Source” — the commands in the scenarios really ran, once,
    and castwright recorded what they printed.
    </p>

    <Callout type="tip">
    Try the controls with the keyboard, and try the page with reduced motion switched on —
    the demos then show their final frame immediately instead of animating, with the
    controls still there for anyone who does want to watch.
    </Callout>

    <h2>Scenarios</h2>

    <Cast
      name="first-demo"
      id="demo-first"
      title="A first demo, end to end"
      lead="Write a demo file, validate it, build it to an SVG and to a cast. Real castwright output, recorded with exec: and --record."
    />
    <Cast
      name="error-fix"
      id="demo-error"
      title="An error, and its fix"
      lead="A typo in a demo file: validate points at the line and column, a one-line fix, and the build goes through."
    />
    <Cast
      name="vhs"
      id="demo-vhs"
      title="A VHS tape, built as is"
      lead="examples/vhs.tape in unchanged VHS syntax. Its commands ran during this site's build; hidden setup included."
    />

    <h2>Features</h2>

    <div class="gallery">
      <Cast name="show" title="A file, highlighted" lead="show: reads a file and highlights it with Shiki, at build time." />
      <Cast name="recorded" title="A real command, recorded" lead="exec: ran castwright once; --record kept exactly what it printed." />
      <Cast name="keys" title="Keys and seeded jitter" lead="Tab completion, human-looking typing — the same bytes on every build." />
      <Cast name="output-delay" title="Output, line by line" lead="delay: prints a block one line at a time." />
      <Cast name="colours" id="demo-colours" title="Colour and style" lead="Named colours follow the theme; #rrggbb is exact." />

    </div>

    <Demo title="The same demo as an SVG" lead="castwright build --format svg — one file, no script, plays inside a plain <img>, on GitHub too.">
      <CodeBlock
        slot="controls"
        code={'castwright build error-fix.terminal.yaml --format svg\n\n<img src="error-fix.svg" alt="…">'}
        lang="shellscript"
      />
      <img
        class="svg-demo"
        src={url('/svg/error-fix.svg')}
        alt="castwright validate reports an unknown key 'sped' at line 5, column 5; after a one-line fix validation passes and the build writes dist/deploy.svg."
      />
    </Demo>

    <h2>One cast, four themes</h2>
    <p>
    A cast stores colours as palette indices and carries its palette in the header, so the
    same compiled demo plays in any of the seven bundled themes.
    </p>

    <div class="gallery themes">
      {
        themes.map((theme) => (
          <Cast name="hero" theme={theme} title={theme} source={false} />
        ))
      }
    </div>

    <h2>Without the chrome</h2>
    <p>
    For a hero section you often want the terminal and nothing else. The controls are
    still there — hover the demo, or tab to it — because a loop that never stops needs a
    way to stop it.
    </p>

    <Cast
      name="hero"
      id="demo-bare"
      title="Bare, looping"
      chrome="none"
      controls="hover"
      source={false}
      lead={'<TerminalDemo demo={demo} autoplay loop chrome="none" controls="hover" />'}
    />
  </div>
</Base>

<style>
  /* This page emits its own prose and cards rather than the theme's
     self-centring section components, so it carries the container itself —
     the same one the theme's own showcase and changelog routes use. */
  .page {
    display: grid;
    gap: 28px;
    max-width: var(--max);
    margin: 0 auto;
    padding: 56px 24px 96px;
  }
  .page > h1 {
    margin: 0;
  }
  .page > .lead {
    max-width: 68ch;
    margin: -16px 0 0;
    color: var(--muted);
  }
  .page > h2 {
    margin: 20px 0 0;
  }
  .page > p {
    max-width: 68ch;
    margin: -16px 0 0;
  }
  .gallery {
    display: grid;
    gap: 28px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    align-items: start;
  }
  .svg-demo {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
