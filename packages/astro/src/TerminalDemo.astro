---
// <TerminalDemo /> — an Astro wrapper around <castwright-demo>.
//
// What it does that hand-writing the element does not: inlines the compiled
// cast as JSON (no fetch, no parser in the bundle), emits the final terminal
// text as the light-DOM accessibility fallback, and reserves the right height
// so hydration does not shift the page.
//
// The cast comes from an import, not a path string:
//
//   ---
//   import demo from '../demos/install.terminal.yaml';
//   import TerminalDemo from '@casoon/astro-castwright/TerminalDemo.astro';
//   ---
//   <TerminalDemo demo={demo} autoplay loop />
//
// A path string would have to be resolved relative to the *calling page*,
// which `import.meta.glob` inside this component cannot do. An import is also
// type-checked and fails the build when the file moves — see
// docs/reference/player.md.
//
// With `src` there is no compiled cast to take the fallback text from, so pass
// it as the slot: <TerminalDemo src="/demo.cast">$ npm install</TerminalDemo>.

import { jsonForScript, reservedHeightPx } from '@casoon/astro-castwright/inline-json';

export interface Props {
  /** A `*.terminal.yaml` import, compiled by the castwright Vite plugin. */
  demo?: { cast: unknown; finalFrame: string };
  /** A pre-built `.cast` served as a static asset, fetched at runtime instead. */
  src?: string;
  autoplay?: boolean;
  loop?: boolean;
  loopDelay?: number;
  poster?: number;
  cols?: number;
  rows?: number;
  /** Accessible name. Defaults to the cast's title. */
  label?: string;
  /** Shown in the window chrome. Decorative. */
  title?: string;
  /** `none` drops the title bar with the traffic lights. */
  chrome?: 'window' | 'none';
  /**
   * `hover` overlays the transport and reveals it on hover or keyboard focus —
   * visually absent, but still a reachable pause control, which an autoplaying
   * loop needs. `none` removes it entirely; only appropriate when the demo does
   * not autoplay in a loop.
   */
  controls?: 'visible' | 'hover' | 'none';
  class?: string;
}

const {
  demo,
  src,
  autoplay = false,
  loop = false,
  loopDelay,
  poster,
  cols,
  rows,
  label,
  title,
  chrome,
  controls,
  class: className,
} = Astro.props;

if (!demo && !src) {
  throw new Error(
    '<TerminalDemo> needs either `demo` (a *.terminal.yaml import) or `src` (a .cast URL).',
  );
}

const cast = demo?.cast as { header?: { width?: number; height?: number } } | undefined;
// Slot content is the fallback for `src`, and overrides the final frame.
const hasSlot = Astro.slots.has('default');
if (!demo && !hasSlot) {
  console.warn(
    '[castwright] <TerminalDemo src="..."> has no fallback: pass the demo\'s final screen as ' +
      'slot content, or assistive technology gets an empty box until the player loads.',
  );
}

// Reserve the terminal's height so upgrading from the fallback to the live
// terminal does not shift the page: rows, title bar, transport and screen
// padding, see reservedHeightPx().
const reservedPx = reservedHeightPx({
  castRows: cast?.header?.height,
  rows,
  chrome,
  controls,
});
const reservedHeight = reservedPx === undefined ? undefined : `${reservedPx}px`;
---

<castwright-demo
  class={className}
  src={src}
  autoplay={autoplay ? '' : undefined}
  loop={loop ? '' : undefined}
  loop-delay={loopDelay}
  poster={poster}
  cols={cols}
  rows={rows}
  label={label}
  title-text={title}
  chrome={chrome}
  controls={controls}
  style={reservedHeight ? `--castwright-reserved-height: ${reservedHeight}` : undefined}
>
  {demo && (
    <script
      type="application/json"
      data-castwright-cast
      is:inline
      set:html={jsonForScript(demo.cast)}
    />
  )}
  {hasSlot ? <slot /> : demo && <pre>{demo.finalFrame}</pre>}
</castwright-demo>

<script>
  // Registers the custom element. Astro hoists and bundles this once per page,
  // no matter how many demos it contains.
  import '@casoon/castwright-player';
</script>
