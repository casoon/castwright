{
  // Typecheck-only: the same sources as the build plus the tests, which are
  // deliberately excluded from tsconfig.json so they stay out of `dist` (and
  // therefore out of the published tarball).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "exclude": [],
  "include": ["src"]
}
